{
  "name": "routetouille-example-react",
  "version": "1.0.0",
  "author": "s3rious a.k.a Leonid Semenov <canismajor@kaschenka.ru>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "format": "biome format . --write",
    "lint": "biome lint . --write",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "palettier": "palettier --src src/components/atoms/Palette/tokens/index.js --dist src/components/atoms/Palette/ --transform cssVariables:Palette.css",
    "predev": "npm run palettier",
    "dev": "vite",
    "mock-api": "node mock-api.js",
    "dev:all": "concurrently \"npm run mock-api\" \"npm run dev\"",
    "prebuild": "npm run palettier",
    "build": "vite build",
    "upgrade": "npx npm-upgrade"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cors": "^2.8.5",
    "effector-logger": "^0.15.0",
    "express": "^5.1.0",
    "palettier": "^2.0.0",
    "tinycolor2": "^1.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "await-to-js": "^3.0.0",
    "classnames": "^2.5.1",
    "core-js": "^3.44.0",
    "effector": "^23.4.1",
    "effector-react": "^23.3.0",
    "effector-storage": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-routetouille": "file:../../packages/react-routetouille",
    "routetouille": "file:../../packages/routetouille"
  }
}
