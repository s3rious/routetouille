{
  "name": "react-routetouille",
  "version": "1.0.0-rc.2",
  "description": "Official React bindings for Routetouille",
  "keywords": [
    "router",
    "route",
    "routing",
    "history",
    "link",
    "react",
    "reactjs"
  ],
  "author": "s3rious a.k.a Leonid Semenov <canismajor@kaschenka.ru>",
  "repository": "s3rious/routetouille",
  "bugs": {
    "url": "https://github.com/s3rious/routetouille/issues"
  },
  "license": "MIT",
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prebuild": "rm -rf ./lib && npm run format && npm run lint && npm run test",
    "build": "tsc",
    "prepublish": "npm run build"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "biome": "^0.3.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "routetouille": "file:../routetouille"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "lib"
  },
  "type": "module",
  "dependencies": {
    "routetouille": "file:../routetouille"
  }
}
