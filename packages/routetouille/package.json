{
  "name": "routetouille",
  "version": "1.0.0-rc.2",
  "description": "The new breed of JavaScript router: hackable, extendable, framework-agnostic, isomorphic, and with the lifecycle",
  "keywords": [
    "router",
    "route",
    "routing",
    "history",
    "link"
  ],
  "author": "s3rious a.k.a Leonid Semenov <canismajor@kaschenka.ru>",
  "repository": "s3rious/routetouille",
  "bugs": {
    "url": "https://github.com/s3rious/routetouille/issues"
  },
  "license": "MIT",
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prebuild": "rm -rf ./lib && npm run format && npm run lint && npm run test",
    "build": "tsc",
    "prepublish": "npm run build",
    "upgrade": "npx npm-upgrade"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "biome": "^0.3.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "nanoevents": "9.1.0"
  },
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "directories": {
    "lib": "lib"
  },
  "type": "module"
}
